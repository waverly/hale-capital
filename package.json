    "@sanity/client": "^7.3.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.89.0",
    "lodash-es": "^4.17.21",
    "next": "15.3.2",
    "next-sanity": "^9.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.5",
    "sanity": "^3.89.0",
    "sanity-plugin-link-field": "^1.4.0",
    "sass": "^1.89.0",
    "styled-components": "^6.1.18",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
